{
  "name": "guandan-hand-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "tsx src/server/dev.ts",
    "test": "vitest run --exclude \"tests/benchmark/**\" --exclude \"tests/simulation/**\" --exclude \"tests/performance/**\" --testTimeout=120000",
    "test:benchmark": "vitest run tests/benchmark --testTimeout=120000 --reporter=verbose",
    "test:simulation": "vitest run tests/simulation --testTimeout=120000",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "simulate:ai": "tsx scripts/runUnifiedAiSimulation.ts",
    "benchmark:ai": "tsx scripts/runAiBenchmark.ts",
    "benchmark:replay": "tsx scripts/replayAiBenchmark.ts",
    "benchmark:d1": "tsx scripts/runD1TopKBenchmark.ts",
    "benchmark:d1:replay": "tsx scripts/replayD1TopKBenchmark.ts",
    "benchmark:d1:freeze": "tsx scripts/freezeD1Calibration.ts",
    "test:ai-performance": "vitest run tests/performance/aiHotPath.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
